# Supabase configuration (placeholder values only)
# Copy this file to `.env.local` and fill in your own project values.
# Never commit real keys. The anon/publishable key is safe to expose in a
# frontend build, but the service_role key must never be used in the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
